# ══════════════════════════════════════════════════════════════
# Akhada Analytics — EC2 Production Environment Variables
# Copy this to .env on your EC2 instance and fill in real values
# ══════════════════════════════════════════════════════════════

# ── Docker Hub username (your Docker Hub username) ──
DOCKERHUB_USERNAME=your_dockerhub_username

# ── MongoDB ──
MONGO_URI=mongodb://mongo:27017/akhada_analytics

# ── Server ──
PORT=5001
NODE_ENV=production

# ── JWT (generate with: openssl rand -base64 32) ──
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Frontend Origin (your Elastic IP or domain) ──
CLIENT_URL=http://YOUR_ELASTIC_IP
