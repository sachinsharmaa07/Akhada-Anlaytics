# ── MongoDB ──
# Local: use Docker Compose MongoDB
# Production: use cloud MongoDB (Atlas, etc.)
MONGO_URI=mongodb://mongo:27017/akhada_analytics

# ── Server ──
PORT=5001
NODE_ENV=development

# ── JWT (Generate with: openssl rand -base64 32) ──
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ── Google OAuth ──
# Create at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Frontend Client URL ──
CLIENT_URL=http://localhost:3000

# ── React Build Variables (used in docker-compose for client build) ──
REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Docker Hub (for CI/CD builds) ──
DOCKERHUB_USERNAME=your_docker_hub_username
DOCKERHUB_TOKEN=your_docker_hub_access_token

# ── EC2 Deployment (for GitHub Actions CD) ──
EC2_HOST=your_ec2_ip_or_domain
EC2_USER=ubuntu
EC2_APP_DIR=/opt/akhada-analytics
NUTRITIONIX_APP_ID=YOUR_NUTRITIONIX_ID
NUTRITIONIX_APP_KEY=YOUR_NUTRITIONIX_KEY
